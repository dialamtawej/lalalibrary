# عنوان Laravel API كما يراه خادم Next.js
# - خارج Docker:  http://localhost:8000/api
# - داخل Docker يُضبط تلقائيًا من docker-compose.yml إلى http://nginx/api
LARAVEL_API_URL=http://localhost:8000/api

# وضع المعاينة للمطورين (بيانات مثال + عقد الـ API للميزات غير المبنية). false في الإنتاج
SHOW_API_CONTRACTS=true
