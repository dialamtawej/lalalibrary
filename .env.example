# ========================================================
# متغيرات Docker المشتركة (يقرؤها docker-compose.yml)
# إعدادات Laravel نفسها في backend/.env
# ========================================================

# قاعدة البيانات: يستخدمها MySQL، ويمررها docker-compose إلى Laravel
# (القيم هنا تتقدم على DB_* الموجودة في backend/.env داخل Docker)
DB_DATABASE=lalalibrary_db
DB_USERNAME=lalalibrary
# ضعي كلمات مرور خاصة بك ولا ترفعي ملف .env إلى Git
DB_PASSWORD=
DB_ROOT_PASSWORD=

# المنافذ على جهازك
APP_PORT=8000
FRONTEND_PORT=3000
FORWARD_DB_PORT=3306

# مستخدم حاوية PHP (اتركيها 1000 على Windows و macOS)
DOCKER_UID=1000
DOCKER_GID=1000

# وضع المعاينة في الواجهة: يعرض الميزات الناقصة ببيانات مثال مع العقد. false في الإنتاج.
SHOW_API_CONTRACTS=true
